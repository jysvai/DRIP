  "basis": {
    "standard": "speedFactor R(승용 가중평균 0.998 ≈ AVC 0.985), timeHeadway R(용량 2,200pcphpl → 평균 차두 1.64초), comfortDecel R(DTG 급감속 기준 2.08m/s² 아래), signalUse R(차로변경 미점등 42.4% 중 늦게 켬 37% → 켬 약 73~81%), signalLead R(켠 차의 약 21%가 직전 2초 미만), 나머지 A",
    "calm": "speedFactor·signalUse R, 나머지 A",
    "aggressive": "speedFactor·signalUse·signalLead R, 나머지 A",
    "novice": "speedFactor·signalUse R, 나머지 A",
    "taxi": "accelScale R(DTG 급가속 많음), comfortDecel R(급감속 적음), signalUse R(사업용 좌회전 방향지시등 위반 71%), speedFactor R",
    "bus_driver": "speedFactor D(AVC 버스 0.958), designatedLaneCompliance D(1차로 위반율 6.34%), comfortDecel R, signalUse R",
    "truck_heavy": "speedFactor D(AVC 대형화물 1.051, 화물 제한속도 기준, 90km/h 속도제한장치로 상한), designatedLaneCompliance D(AVC 0.903), comfortDecel R",
    "light_commercial": "speedFactor R(AVC 소형화물 0.914에 1.5톤 초과 화물이 섞인 것으로 보고 올림), keepRightBias R(2005 관측: 1.5톤 이하 화물 1차로 12.0%, 승용 29.9%)",
    "van_family": "standard와 같고 busLaneCompliance만 0.5 (전용차로 승합차 약 99%가 탑승 기준 미달, 비율 자체는 가정)",
    "assignment": "승용 성향 비율(보통 0.6·여유 0.17·공격적 0.15·초보 0.08)은 직접 근거를 못 찾은 가정값. validationTargets로 거꾸로 맞춘다",
    "passingLaneCruise": "standard 0.35 R(추월 목적 없이 1차로 계속 주행 자기보고: 편도 3차로 35%, 2차로 40% 이상 — SBS 2023), 나머지 A. 게임에서 승용 1차로 점유가 AVC 0.44(3차로)·0.34(4차로)에 가깝게 되는지로 확인"
  },
