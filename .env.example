# 이 파일을 .env 로 복사한 뒤 값을 채운다. .env 는 git에 올라가지 않는다.
# 키는 채팅이나 코드에 붙이지 말고 여기에만 둔다.

# 공공데이터포털 (data.go.kr) → 마이페이지 → 개발계정 → 일반 인증키 (Decoding)
DATA_GO_KR_KEY=

# ITS 국가교통정보센터 오픈데이터 (its.go.kr/opendata) 인증키
ITS_API_KEY=

# 고속도로 공공데이터 포털 (data.ex.co.kr) 인증키
EX_API_KEY=

# Supabase (리전: Seoul)
# 상단 Connect 버튼 → Connection String → Session pooler 의 URI를 그대로 붙인다. [YOUR-PASSWORD]는 고치지 않는다.
# (Direct connection은 IPv6 전용이라 집 인터넷에서 안 될 수 있다.)
SUPABASE_DB_URL=
# 프로젝트 만들 때 정한 DB 비밀번호. 특수문자가 있어도 코드가 알아서 처리한다.
SUPABASE_DB_PASSWORD=
# Project Settings → Data API 의 Project URL
SUPABASE_URL=
# Project Settings → API Keys. sb_publishable_ 로 시작. 게임(브라우저)에 넣어도 되는 키.
SUPABASE_PUBLISHABLE_KEY=
# sb_secret_ 로 시작. 서버·수집기 전용. 게임(브라우저)에는 절대 넣지 않는다.
SUPABASE_SECRET_KEY=

# Cloudflare R2 → R2 → Manage R2 API Tokens
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
